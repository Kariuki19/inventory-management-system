rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the current user is the admin or staff associated with adminUid
    function isOwnerOrStaff(adminUid) {
      return request.auth != null && (
        request.auth.uid == adminUid || 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.adminUid == adminUid
      );
    }

    // Helper function to check if the current user is an admin
    function isAdmin() {
      return request.auth != null && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users collection rules
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      allow read, write: if request.auth != null && 
        resource != null && resource.data.adminUid == request.auth.uid;
      
      allow read: if request.auth != null && resource.data.role == 'admin';
    }

    // Subcollections under users/{adminUid} (Data Isolation) — real tenant data
    match /users/{adminUid}/inventory_items/{document} {
      allow read, write: if isOwnerOrStaff(adminUid);
    }
    
    match /users/{adminUid}/stock_movements/{document} {
      allow read, write: if isOwnerOrStaff(adminUid);
    }
    
    match /users/{adminUid}/stock_predictions/{document} {
      allow read, write: if isOwnerOrStaff(adminUid);
    }
    
    match /users/{adminUid}/categories/{document} {
      allow read: if isOwnerOrStaff(adminUid);
      allow write: if isOwnerOrStaff(adminUid) && isAdmin();
    }

    // Legacy/top-level live collections — see note below before deploying
    match /categories/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /inventory_items/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /stock_movements/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /stock_predictions/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Shared public demo dataset — lives under a single reserved doc ID
    // ("demo_admin_seed") that is NOT a real account, matching how
    // InventoryService actually routes anonymous/trial users (see
    // _sharedDemoAdminUid in inventory_service.dart). Read-only for any
    // authenticated user (including anonymous); only the Admin SDK seed
    // script can write to these. Scoping to the exact doc ID (rather than a
    // wildcard) means this never overlaps with a real admin's own data.
    match /users/demo_admin_seed/demo_categories/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/demo_admin_seed/demo_inventory_items/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/demo_admin_seed/demo_stock_movements/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/demo_admin_seed/demo_stock_predictions/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Support global app_config collection (FAQ, Pricing, Contacts)
    match /app_config/{document} {
      allow read: if request.auth != null;
      allow write: if false;
    }
    
    // Allow authenticated users to read and write image uploads
    match /images/{document} {
      allow read, write: if request.auth != null;
    }
  }
}